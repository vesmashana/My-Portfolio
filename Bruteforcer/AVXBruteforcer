//The initial bruteforcer model cannot be vectorised 
//Thus, I convert the recursive model to an iterative one from 1 to L^94 (where L is length of guess)
#include <iostream>
#include <chrono>
#include <immintrin.h>

std::string password;
std::string guess;

void convertIntToString(long long num, int length) {
	for (int i = length - 1; i >= 0; i--) {
		int character = num % 94 + 33;
		num = num / 94; 
		guess[i] = static_cast<char>(character);

	}
	//std::cout << "Guess: " << guess << std::endl;
}

