//The initial bruteforcer model cannot be vectorised 
//Thus, I convert the recursive model to an iterative one from 1 to L^94 (where L is length of guess)
#include <iostream>
#include <chrono>
std::string password;
std::string guess;

void convertIntToString(long long num, int length) {
	for (int i = length - 1; i >= 0; i--) {
		int character = num % 94 + 33;
		num = num / 94; 
		guess[i] = static_cast<char>(character);

	}
	//std::cout << "Guess: " << guess << std::endl;
}

bool bruteForcer(int length) {
	for (long long i = 0; i < pow(94, length); i++) {
		convertIntToString(i, length);
		if (guess == password) {
			std::cout << ("Password found: " + guess) << std::endl;
			return true;
		}
	}
	return false;
}

int main() {
	std::cout << "Enter your password: ";
	std::cin >> password;
	auto start = std::chrono::high_resolution_clock::now();
	for (int length = 4; length <= 10; length++) {
		guess.resize(length);
		if (bruteForcer(length)) break;
	}
	auto end = std::chrono::high_resolution_clock::now();
	double secs = std::chrono::duration<double>(end - start).count();
	std::cout << "Elapsed: " << secs << "s\n";
